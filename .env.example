# Mentalaba AI Agent — Environment config namunasi
# .env faylini yaratib, quyidagi qiymatlarni kiriting.

# ⚠️ MUHIM: MENTALABA_API_KEY ni terminal/shell ga EXPORT QILMANG!
# Next.js process.env o'zgaruvchisini .env faylidan USTUN qo'yadi.
# Agar shell'da eski/muddati o'tgan token export qilingan bo'lsa, server
# .env dagi yangi tokenni emas, ESKISINI ishlatadi → hamma API so'rovlar 401
# qaytaradi. Yechim: `env -u MENTALABA_API_KEY` bilan ishga tushiring yoki
# shell'ni qayta oching.

# MENTALABA API (universitet/yo'nalish/grant ma'lumotlari)
MENTALABA_API_KEY=
MENTALABA_REFRESH_TOKEN=
MENTALABA_API_URL=https://api.mentalaba.uz/v1

# ======================================================================
# 🔐 MENTALABA AUTH (user login) — 2026-08 qo'shildi
# ======================================================================
# Foydalanuvchi mentalaba.uz saytida login qiladi → frontend token'ni
# `Authorization: Bearer <token>` header orqali chat API'ga yuboradi.
#
# GUEST REJIM: login qilmagan foydalanuvchi ham AI'ni ishlatadi — 401
# qo'yilmaydi. Brauzer X-Guest-Id header'ida UUID yuboradi, guest session'lari
# shu id bo'yicha izolyatsiya qilinadi, lekin tarixi saqlanmaydi. Login
# qilganda guest session user'ga ulanadi (claim).
#
# Frontend token'ni quyidagi manbalardan topadi:
#   1. URL parametr:  ?token=...&refreshToken=...  (mentalaba.uz redirect qilganda)
#   2. localStorage:  accessToken / token / mentalaba_access_token va boshqalar
#
# Har user o'z tokeni bilan Mentalaba API'ga murojaat qiladi. Token muddati
# o'tsa — /v1/auth/refresh orqali avtomatik yangilanadi (DB'da saqlanadi),
# .env dagi global token har 3 kunda almashtirish SHAKTT EMAS.

# AI provider'lar (kamida bittasi kerak)
# Groq (eng tez, bepul): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (bepul backup): https://aistudio.google.com/apikey
# DIQQAT: 'gemini-1.5-turbo' va 'gemini-2.0-flash' 404/429 qaytarishi mumkin —
# ishlaydigan model: gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (ixtiyoriy, oxirgi fallback)
OPENAI_API_KEY=

# Jina AI (embedding — RAG uchun, ixtiyoriy)
JINA_API_KEY=

# Server porti (standart 3000)
PORT=3000

# 🔌 AI'ni o'chirish (template rejim)
# AI_MODE=template yozilsa, Groq/Gemini/OpenAI ishga tushmaydi va agent barcha
# javoblarni shablon (template) orqali beradi — API key'larni o'chirish shart emas.
# AI yoqilgan rejimga qaytish uchun bu satrni o'chirib, serverni restart qiling.
# AI_MODE=template

# 📊 ANALYTICS (BOSQICH 7): har bir javob uchun JSONL log faylga yozish.
# Yoqilgan bo'lsa intent/strategy/provider/latency/success/fallback/tool
# analytics faylga append qilinadi (statistika uchun).
# ANALYTICS_FILE=./logs/analytics.ndjson

# 🔀 OpenRouter (Groq limiti tugaganda zaxira provider — 100+ model)
# Key: https://openrouter.ai/keys dan olinadi
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# 🔄 DeepSeek (OpenRouter ham tugasa zaxira provider)
# Key: https://platform.deepseek.com dan olinadi
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-v4-flash
